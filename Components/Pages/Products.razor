@page "/products"
@using Microsoft.AspNetCore.Components.QuickGrid
@rendermode InteractiveServer
<div class="row">
    <div class="col-sm-4">
        <a @onclick="@showAddNewProduct" class="btn btn-primary mb-3" style="float:right">Add New Product</a>
    </div>
</div>

<div class="row">
    
        <div class="col-sm-8">
            @if (products.Any())
            {
                <QuickGrid Items="@products">
                    <PropertyColumn Title="Id" Property="@(p => p.Id)" Sortable="true" />
                    <PropertyColumn Title="Product Name" Property="@(p => p.Name)" Sortable="true" />
                    <PropertyColumn Title="Product Price" Property="@(p => p.Price)" />
                        <TemplateColumn Title="Edit">
                    <button type="button" style="background-color: white; border: none; outline: none; box-shadow: none;" @onclick="@(() => EditProduct(context.Id))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#E6D727" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z" />
                        </svg>
                    </button>
                        </TemplateColumn>
                <TemplateColumn Title="Delete">
                    <button type="button" style="background-color: white; border: none; outline: none; box-shadow: none;" @onclick="@(() => DeleteProduct(context.Id))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#E81C09" class="bi bi-trash" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                        </svg>
                    </button>
                </TemplateColumn>
                </QuickGrid>
            }
            else
            {
                @* This section handles the empty state *@
                <div class="alert alert-info mt-3">
                    <strong>No data found!</strong> Try adjusting your filters or adding a new product.
                </div>
            }
        </div>
        <div class="col-sm-4">
        @if (showAddProduct){
            <AddProducts componentDisabled="receivedCancel" OnProductAdded="receivedProductAdd" ProductId="@selectedProductId"></AddProducts>
        }
        @if(showRemoveProduct){
            <RemoveProducts ProductId="@selectedProductId" onProductRemoved="receivedProductRemoved" componentDisabled="receivedRemoveCancel"></RemoveProducts>
        }
        </div>
    
</div>




