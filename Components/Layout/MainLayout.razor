@using MYBlazorAPP.Services
@inherits LayoutComponentBase
@implements IDisposable


<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <h1 class="header-text">@headerTitle</h1>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@code{
    [Inject]
    public HeaderMessageServices MsgService { get; set; }

    private string headerTitle = "";

    protected override void OnInitialized()
    {
        // Subscribe to the event
        MsgService.onMessageReceived += HandleMessage;
    }

    private void HandleMessage(string newMessage)
    {
        headerTitle = newMessage;
        InvokeAsync(StateHasChanged); // Force UI update
    }

    public void Dispose()
    {
        // Unsubscribe to avoid memory leaks!
        MsgService.onMessageReceived -= HandleMessage;
    }
}
